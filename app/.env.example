# Copy to `.env.local` (gitignored) and fill in your own values.
# Both keys are optional — without them the checkout flow simulates Supabase
# signup instead of calling the real API, so the UI stays runnable.
#
# Use the SAME Supabase project that the Smart-Dental clinic app uses, so
# trial signups land in the same auth/users table the clinic app reads from.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Where the confirmation email link should redirect users. Defaults to
# /checkout/success on the current origin when unset.
VITE_APP_REDIRECT_URL=https://app.avasmartdental.ph

# Public URL of the installable clinic app (the PWA). The Downloads page
# "Install Ava" button opens this. Defaults to https://app.avasmartdental.ph.
VITE_APP_URL=https://app.avasmartdental.ph
